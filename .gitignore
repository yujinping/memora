/target
/data
# 本地运行配置（含 admin_token，不应入库）；部署模板见 deploy/config.toml.template
config.toml
# 旧版 `.env` 配置已被 config.toml 取代，保留忽略规则以防历史文件被误提交
.env
*.db
*.db-shm
*.db-wal

# macOS 元数据
.DS_Store

# 前端依赖与本地缓存（产物 src/console_dist/ 是**要提交**的，见 scripts/build-web.sh）
web/node_modules/
web/.npm-cache/
web/.pnpm-store/
web/_tmp_*
web/node_modules/_tmp_*
# vue-tsc 的增量编译缓存（每次构建都变，入库只会制造 diff 噪声）
web/tsconfig.tsbuildinfo
# npm 的 lockfile：本项目用 pnpm（见 scripts/build-web.sh），两份 lockfile 必然分叉
web/package-lock.json

# Python 字节码缓存（scripts/ 下运行脚本会产生）
__pycache__/

# AI 助手内部工作记忆（非项目源码，不纳入版本库）
.workbuddy/
