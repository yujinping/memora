# Caddyfile 片段 —— 为 Memora 提供自动 HTTPS 反向代理
#
# 由 `memora init` 渲染。使用步骤：
#   1. 把 mem.example.com 换成你的真实域名（需已解析到本机，且 80/443 可达）；
#   2. 将本片段并入 /etc/caddy/Caddyfile（同域名存在时请合并，不要重复定义站点）；
#   3. sudo systemctl reload caddy
#
# ⚠ 关键前置：`config.toml` 中的 `mcp_allowed_hosts` 必须包含下面的域名。
#   rmcp 的 Streamable HTTP 传输默认只信回环 Host（防 DNS 重绑定），而反代会透传
#   真实域名；白名单未命中时 MCP 请求会被协议层以 403 拒绝，且错误信息并不指向配置项。
#
# 只暴露四个前缀，其余一律 404：记忆库里是私有内容，不应存在未预期的暴露面。
mem.example.com {
	handle /mcp* {
		reverse_proxy 127.0.0.1:__PORT__
	}

	handle /api/v1/* {
		reverse_proxy 127.0.0.1:__PORT__
	}

	# 网页控制台。页面本身不含任何数据（只是一份 SPA 空壳），
	# 但**必须**在反代里放行，否则公网部署下浏览器打开 /admin 会拿到 404。
	# 这条是实测发现的：原先只代理 mcp / api / health 三个前缀，
	# 控制台在 localhost 直连时正常，一上 Caddy 就消失。
	handle /admin* {
		reverse_proxy 127.0.0.1:__PORT__
	}

	# 控制台的构建产物（js / css）。漏掉这一条的形态很隐蔽：入口 HTML 返回 200，
	# 页面能打开，但脚本与样式全 404，于是看到一片没有样式的空白——
	# 直连 localhost 时一切正常，只有经反代才出现。
	handle /assets/* {
		reverse_proxy 127.0.0.1:__PORT__
	}

	handle /favicon.svg {
		reverse_proxy 127.0.0.1:__PORT__
	}

	handle /health {
		reverse_proxy 127.0.0.1:__PORT__
	}

	# 兜底：必须放在 handle 块里。
	# 不能写成顶层的裸 `respond 404`——Caddy 的 directive 排序会把 respond 提到
	# reverse_proxy 之前执行，从而拦掉上面几条代理规则。
	handle {
		respond 404
	}

	encode zstd gzip
}
