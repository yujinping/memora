# Memora (忆庐) 运行配置示例
#
# 本文件与 deploy/env.template（`memora init` 生成 .env 所用的模板）同源，
# 修改其中一份时请同步另一份。也可以直接执行 `memora init` 由模板生成 .env。
#
# 配置优先级（高 → 低）：
#   命令行选项 > 进程环境变量 > 本文件 > 内置默认值
# 本文件不会被 `dotenvy` 覆盖已存在的进程环境变量，因此 systemd 的
# EnvironmentFile= 与这里的取值可以共存而互不打架。
#
# 探测顺序：CWD/.env → 可执行文件目录/.env → DATA_DIR/.env
# 若发现「改了本文件却没生效」，请查看 `memora run` 启动日志中打印的 .env 路径，
# 或直接用 `memora run --env-file /absolute/path/.env` 显式指定。

# 监听端口（1..=65535；取值非法会直接报错退出，不会静默回退默认值）
PORT=6789

# 数据存储目录（每项目独立 SQLite 文件存放于此；PID 文件与后台日志也在此目录）
DATA_DIR=./data

# 管理员令牌：REST 管理层（/api/v1）鉴权，生产环境必须设置且足够随机
#   openssl rand -hex 32
# 生成后请把本文件权限收紧为 600：chmod 600 .env
ADMIN_TOKEN=change-me

# 新项目的默认存储后端（既有项目以其在 _meta.db 中的登记值为准）
# 可选：sqlite_file（默认，每项目一个 SQLite 文件）| in_mem（仅测试，进程退出即丢失）
# sqlite_single / postgres 预留，本构建未编译
STORAGE_BACKEND=sqlite_file

# MCP 端点允许的 Host 白名单（逗号分隔，防 DNS 重绑定）
# 默认仅 localhost / 127.0.0.1 / ::1。**公网部署必须加入对外域名**，
# 因为 Caddy 反代会透传真实 Host，不在白名单内会被协议层以 403 拒绝。
# MCP_ALLOWED_HOSTS=mem.example.com,localhost,127.0.0.1

# 日志级别（可选）。默认 info，并把 sqlx / sea-orm 压到 warn。
# 注意：本变量在加载本文件之后才被读取，因此写在这里是生效的。
# RUST_LOG=info,sqlx=warn,sea_orm=warn

# 可选：远程 embedding API Key（P7 语义检索启用）
# EMBEDDING_API_KEY=sk-...
